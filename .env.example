# Aurora Environment Configuration Template
# Copy to .env for local overrides. Do NOT commit secrets or live keys.

# System & Mode Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Backend Authoritative Database
DATABASE_URL=sqlite:///./aurora_operational.db

# LLM & AI Providers (Online Mode)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Embeddings Configuration
CHROMA_PERSIST_DIRECTORY=./data/chromadb
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Security & CORS Setup
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
